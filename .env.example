SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project.supabase.co"

# Content Intelligence (research + draft generation)
ANTHROPIC_API_KEY="your-anthropic-api-key"
# Optional, defaults to claude-sonnet-5.
ANTHROPIC_MODEL=""
# Shared secret the discovery cron job sends as the x-cron-secret header.
CONTENT_CRON_SECRET="generate-a-random-secret"

# LinkedIn publishing (Company Page posts, generated from published articles)
LINKEDIN_CLIENT_ID="your-linkedin-app-client-id"
LINKEDIN_CLIENT_SECRET="your-linkedin-app-client-secret"
LINKEDIN_REDIRECT_URI="https://your-domain/api/auth/linkedin/callback"
# 32 random bytes, base64-encoded — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LINKEDIN_TOKEN_ENCRYPTION_KEY="generate-a-32-byte-base64-key"
# Optional, defaults to 202601. LinkedIn versions its REST API by YYYYMM.
LINKEDIN_API_VERSION=""
